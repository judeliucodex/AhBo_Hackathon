# Ah Bo environment (§26.2). Copy is made by `make init-secrets` → .env (mode 600, git-ignored).
# Never commit .env. Never print a key (at most its last 4 characters).

# --- Runtime -------------------------------------------------------------------------------------
# Public origin served by Caddy (auto-TLS for this host name).
PUBLIC_BASE_URL=https://srv2135273.hstgr.cloud
# demo (scripted F4, scenario clock anchors) or production.
AHBO_PROFILE=demo
# What to fake: comma list of models,speech,livekit,telegram,twilio,vision — or all / none. Default all ($0).
AHBO_FAKE=all
TZ=Asia/Hong_Kong

# --- Generated by `ahbo init-secrets` (leave empty here) -----------------------------------------
# iPad device-channel secret (entered once in the iPad's hidden settings; `make show-app-secret`).
APP_SECRET=
# agent → api calls on the Docker network only (/internal/*).
INTERNAL_TOKEN=
# Signs the operator login cookie.
SESSION_SECRET=
# bcrypt hash of the operator password; set with `make set-password` (plaintext never stored, BUILD_LOG D-4).
OPERATOR_PASSWORD_HASH=

# --- Models (real Flash / Sonnet; remove `models` from AHBO_FAKE when set) ----------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Real Sonnet, Haiku and vision.
ANTHROPIC_API_KEY=
# Optional alternative LLM route only (§24.16).
OPPER_API_KEY=

# --- Speech (Azure STT/TTS; remove `speech` from AHBO_FAKE when set) ----------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
AZURE_TTS_VOICE=zh-HK-HiuMaanNeural
# Optional TTS fallback; voice/model ids come from the owner (§19 #12).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# --- LiveKit Cloud (real voice sessions; remove `livekit` from AHBO_FAKE when set) ---------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Telegram (family link; remove `telegram` from AHBO_FAKE when set) ---------------------------
TELEGRAM_BOT_TOKEN=
# Generated; checked on every webhook (X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_WEBHOOK_SECRET=
# name:chat_id pairs, e.g. 阿珍:123456789 (get it with the bot's /whoami).
FAMILY_TELEGRAM_CHAT_IDS=

# --- Twilio (phone link; remove `twilio` from AHBO_FAKE when set) --------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# E.164, verified caller IDs only. NEVER an emergency number (999/112/911 are rejected, INV-9).
EMERGENCY_SIM_PHONE=
FAMILY_PHONE=

# --- Beacon ---------------------------------------------------------------------------------------
# beacon_id:token pairs, e.g. beacon1:<token> (stored hashed at seed).
BEACON_TOKENS=
