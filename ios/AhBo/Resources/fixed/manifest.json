{"version":"f-dcfc2e6081a0","clips":{"F1":{"file":"F1.m4a","text":"哎呀！我感應到你好似跌低咗！","segments":[[0,1,0.0,0.19],[1,3,0.19,0.38],[3,4,0.57,0.76],[4,5,0.76,0.95],[5,6,0.95,1.14],[6,7,1.14,1.33],[7,8,1.33,1.52],[8,9,1.52,1.71],[9,10,1.71,1.9],[10,11,1.9,2.09],[11,12,2.09,2.28],[12,14,2.28,2.47]],"duration":2.66},"F2":{"file":"F2.m4a","text":"我而家影張相睇吓先。","segments":[[0,1,0.0,0.19],[1,2,0.19,0.38],[2,3,0.38,0.57],[3,4,0.57,0.76],[4,5,0.76,0.95],[5,6,0.95,1.14],[6,7,1.14,1.33],[7,8,1.33,1.52],[8,10,1.52,1.71]],"duration":1.9},"F3":{"file":"F3.m4a","text":"王婆婆，如果你冇跌親，請講「我冇事」。","segments":[[0,1,0.0,0.19],[1,2,0.19,0.38],[2,4,0.38,0.57],[4,5,0.76,0.95],[5,6,0.95,1.14],[6,7,1.14,1.33],[7,8,1.33,1.52],[8,9,1.52,1.71],[9,11,1.71,1.9],[11,12,2.09,2.28],[12,13,2.28,2.47],[13,15,2.66,2.85],[15,16,2.85,3.04],[16,19,3.04,3.23]],"duration":3.61},"F4":{"file":"F4.m4a","text":"我已經打電話俾阿珍，佢就嚟幫你。唔使驚，阿寶喺度陪住你。","segments":[[0,1,0.0,0.19],[1,2,0.19,0.38],[2,3,0.38,0.57],[3,4,0.57,0.76],[4,5,0.76,0.95],[5,6,0.95,1.14],[6,7,1.14,1.33],[7,8,1.33,1.52],[8,10,1.52,1.71],[10,11,1.9,2.09],[11,12,2.09,2.28],[12,13,2.28,2.47],[13,14,2.47,2.66],[14,16,2.66,2.85],[16,17,3.04,3.23],[17,18,3.23,3.42],[18,20,3.42,3.61],[20,21,3.8,3.99],[21,22,3.99,4.18],[22,23,4.18,4.37],[23,24,4.37,4.56],[24,25,4.56,4.75],[25,26,4.75,4.94],[26,28,4.94,5.13]],"duration":5.32},"F4p":{"file":"F4p.m4a","text":"我已經打電話俾阿珍，佢好快會嚟幫你。唔使驚，阿寶喺度陪住你。","segments":[[0,1,0.0,0.19],[1,2,0.19,0.38],[2,3,0.38,0.57],[3,4,0.57,0.76],[4,5,0.76,0.95],[5,6,0.95,1.14],[6,7,1.14,1.33],[7,8,1.33,1.52],[8,10,1.52,1.71],[10,11,1.9,2.09],[11,12,2.09,2.28],[12,13,2.28,2.47],[13,14,2.47,2.66],[14,15,2.66,2.85],[15,16,2.85,3.04],[16,18,3.04,3.23],[18,19,3.42,3.61],[19,20,3.61,3.8],[20,22,3.8,3.99],[22,23,4.18,4.37],[23,24,4.37,4.56],[24,25,4.56,4.75],[25,26,4.75,4.94],[26,27,4.94,5.13],[27,28,5.13,5.32],[28,30,5.32,5.51]],"duration":5.7},"F5":{"file":"F5.m4a","text":"好啦，冇事就好。阿寶喺度陪住你。","segments":[[0,1,0.0,0.19],[1,3,0.19,0.38],[3,4,0.57,0.76],[4,5,0.76,0.9