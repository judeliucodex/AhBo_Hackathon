# api image: FastAPI + Care Kernel + all adapters. Code is bind-mounted at /repo (BUILD_LOG D-2).
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TZ=Asia/Hong_Kong UV_SYSTEM_PYTHON=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg tzdata ca-certificates sqlite3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /usr/local/bin/uv
COPY pyproject.toml /build/pyproject.toml
RUN mkdir -p /build/ahbo && touch /build/ahbo/__init__.py \
    && cd /build && uv pip install --system --no-cache ".[dev]" && uv pip uninstall --system ahbo
ENV PYTHONPATH=/repo/brain
WORKDIR /repo/brain
CMD ["uvicorn", "ahbo.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
